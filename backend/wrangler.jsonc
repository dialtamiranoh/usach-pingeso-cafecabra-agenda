{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "usach-pingeso-cafecabra-agenda",
  "compatibility_date": "2026-09-29",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "src/index.ts",
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "assets": {
    "directory": "../frontend/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api",
      "/api/*"
    ],
    "binding": "ASSETS"
  },
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": false,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    }
  },
  "upload_source_maps": true,
  "vars": {
    "APP_ENV": "production",
    "BETTER_AUTH_URL": "https://usach-pingeso-cafecabra-agenda.diego-altamirano-h.workers.dev",
    "BETTER_AUTH_TRUSTED_ORIGINS": "https://usach-pingeso-cafecabra-agenda.diego-altamirano-h.workers.dev",
    "ADMIN_EMAIL": "cafecabrachile@gmail.com"
  },
  "r2_buckets": [
    {
      "binding": "R2_PAGOS",
      "bucket_name": "cafecabra-pagos"
    }
  ],
  "d1_databases": [
    {
      "binding": "cafe_cabra_agenda_db",
      "database_name": "cafe-cabra-agenda-db",
      "database_id": "696def05-b2dd-47aa-b259-a326b3404729",
      "migrations_dir": "migrations"
    }
  ],
  "env": {
    "staging": {
      "name": "usach-pingeso-cafecabra-agenda-dev",
      "triggers": {
        "crons": ["*/15 * * * *"]
      },
      "vars": {
        "APP_ENV": "staging",
        "BETTER_AUTH_URL": "https://usach-pingeso-cafecabra-agenda-dev.diego-altamirano-h.workers.dev",
        "BETTER_AUTH_TRUSTED_ORIGINS": "https://usach-pingeso-cafecabra-agenda-dev.diego-altamirano-h.workers.dev",
        "ADMIN_EMAIL": "dialtamiranoh@gmail.com"
      },
      "r2_buckets": [
        {
          "binding": "R2_PAGOS",
          "bucket_name": "cafecabra-pagos"
        }
      ],
      "d1_databases": [
        {
          "binding": "cafe_cabra_agenda_db",
          "database_name": "cafe-cabra-agenda-db-dev",
          "database_id": "bb597bc4-21dd-4558-a27a-a0e9f311eaf1",
          "migrations_dir": "migrations"
        }
      ],
      "images": {
        "binding": "IMAGES"
      }
    },
    "local": {
      "name": "usach-pingeso-cafecabra-agenda-local",
      "vars": {
        "APP_ENV": "local",
        "BETTER_AUTH_URL": "http://localhost:5173",
        "BETTER_AUTH_TRUSTED_ORIGINS": "http://localhost:5173,http://127.0.0.1:5173,http://localhost:8787,http://127.0.0.1:8787",
        "ADMIN_EMAIL": "dialtamiranoh@gmail.com"
      },
      "r2_buckets": [
        {
          "binding": "R2_PAGOS",
          "bucket_name": "cafecabra-pagos"
        }
      ],
      "d1_databases": [
        {
          "binding": "cafe_cabra_agenda_db",
          "database_name": "cafe-cabra-agenda-db-dev",
          "database_id": "bb597bc4-21dd-4558-a27a-a0e9f311eaf1",
          "migrations_dir": "migrations"
        }
      ],
      "images": {
        "binding": "IMAGES"
      }
    }
  }
}