{
  "name": "@cafecabra/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "typecheck": "tsc --noEmit",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy:dev": "wrangler deploy --env staging",
    "deploy:prod": "wrangler deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv worker-configuration.d.ts",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "hono": "^4.0.0",
    "drizzle-orm": "^0.45.3",
    "html-to-text": "^10.0.1",
    "mailparser": "^3.9.32",
    "resend": "^6.18.0-canary.0",
    "@cafecabra/shared": "0.1.0"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "wrangler": "^4.143.1",
    "drizzle-kit": "^0.31.11",
    "@types/node": "^26.6.3",
    "@types/html-to-text": "^9.0.4",
    "@types/mailparser": "^3.9.0"
  }
}
